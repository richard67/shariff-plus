{
  "name": "shariff-plus",
  "version": "3.0.0-dev",
  "description": "Shariff-Plus enables website users to share or like their favorite content without compromising their privacy. It is based on Shariff by Heise Medien GmbH & Co. KG.",
  "main": "src/js/shariff.js",
  "type": "module",
  "scripts": {
    "dev": "npm run -s build && npm run -s copy_demo && node_modules/sass/sass.js --style=expanded --no-source-map demo/app.scss demo/app.css && npx http-server -p 3000 demo/",
    "test": "eslint src && mocha -r jsdom-global/register",
    "compile_css_exp": "node_modules/sass/sass.js --load-path=. --style=expanded --no-source-map src/style/shariff-complete.scss:dist/shariff.complete.css src/style/shariff.scss:dist/shariff.min.css",
    "compile_css_min": "node_modules/sass/sass.js --load-path=. --style=compressed --no-source-map src/style/shariff-complete.scss:dist/shariff.complete.min.css src/style/shariff.scss:dist/shariff.min.min.css",
    "compile_css_dlg_exp": "node_modules/sass/sass.js --style=expanded --no-source-map src/style/dialogs/facebooklike_dlg.scss dist/facebooklike_dlg.css",
    "compile_css_dlg_min": "node_modules/sass/sass.js --style=compressed --no-source-map src/style/dialogs/facebooklike_dlg.scss dist/facebooklike_dlg.min.css",
    "compile_css": "npm run -s compile_css_exp && npm run -s compile_css_min && npm run -s compile_css_dlg_exp && npm run -s compile_css_dlg_min",
    "compile_js": "rollup -c rollup.config.js",
    "copy_fonts": "cp node_modules/@fortawesome/fontawesome-free/webfonts/*.woff2 dist/",
    "copy_demo": "rm -f demo/*.css && rm -f demo/*.js && rm -f demo/*.woff2 && cp dist/*.* demo/",
    "build": "rm -fr dist && mkdir dist && npm run -s compile_css && npm run -s compile_js && npm run -s copy_fonts",
    "build_zip": "7z a -tzip $BASE_NAME.zip ./dist/* && 7z a -ttar $BASE_NAME.tar ./dist/* && 7z a $BASE_NAME.tar.gz $BASE_NAME.tar"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/richard67/shariff-plus"
  },
  "author": {
    "name": "Richard Fath (shariff-plus)",
    "email": "richard@richard-fath.de"
  },
  "contributors": [
    {
      "name": "Ines Pauer (shariff)",
      "email": "ipa@heise.de"
    },
    {
      "name": "Philipp Busse (shariff)",
      "email": "pmb@heise.de"
    },
    {
      "name": "Sebastian Hilbig (shariff)",
      "email": "seh@heise.de"
    },
    {
      "name": "Erich Kramer (shariff)",
      "email": "km@heise.de"
    },
    {
      "name": "Deniz Sesli (shariff)",
      "email": "dzs@heise.de"
    }
  ],
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://www.richard-fath.de/en/software/shariff-plus.html",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.39.2",
    "jsdom": "^27.4.0",
    "jsdom-global": "^3.0.2",
    "mocha": "^11.7.5",
    "rollup": "^4.54.0",
    "sass": "^1.97.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0"
  },
  "keywords": [
    "heise",
    "richard67",
    "social buttons",
    "shariff-plus",
    "shariff"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.js": "eslint --cache --fix"
  }
}
